# Compose env for scripts/compose.sh. Copy to .env.
# Native PHP/Node still uses backend/.env and frontend/.env.
# Generate APP_KEY with: echo "base64:$(openssl rand -base64 32)"

APP_NAME=LAUNCHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Leave empty to start a MySQL container (profile mysql).
# Host MySQL: DB_HOST=host.docker.internal
# Another container: DB_HOST=<service-or-container-name> and set PROXY_NETWORK or docker network connect.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=launchr
DB_USERNAME=launchr
DB_PASSWORD=launchr
MYSQL_ROOT_PASSWORD=launchr

# Publish the internal nginx edge. Unset to publish nothing (existing proxy only).
APP_PORT=8080

# Join an existing Docker network so Caddy/Traefik can reach service web:80.
# PROXY_NETWORK=proxy
PROXY_NETWORK=

# COMPOSE_MODE=prod uses compose.prod.yaml instead of compose.dev.yaml when you
# do not pass your own -f flags.
COMPOSE_MODE=dev

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite HMR when the browser hits APP_PORT (HTTP). Behind TLS set:
# VITE_HMR_PROTOCOL=wss
# VITE_HMR_CLIENT_PORT=443
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=8080

# Existing Caddy (this stack does not publish 80/443):
# hostname {
#     reverse_proxy web:80
# }
#
# Traefik: attach PROXY_NETWORK and route Host() to http://web:80.
